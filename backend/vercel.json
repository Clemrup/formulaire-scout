{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/templates/(.*)", "dest": "/templates/$1" },
    { "src": "/api/.*", "dest": "/server.js" },
    { "src": "/reponses.*", "dest": "/server.js" },
    { "src": "/.*", "dest": "/server.js" }
  ]
}
